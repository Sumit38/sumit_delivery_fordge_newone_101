# Test environment template. Copy to .env.test and fill in.
# .env.test is git-ignored. Never commit real keys.
#
# IMPORTANT: point these at a DEDICATED Supabase TEST project, never production.
# Tests create users and data and then delete them.

TEST_ENV=local

# App under test. Leave BASE_URL empty and Playwright starts `npm run dev` itself.
BASE_URL=
API_URL=http://localhost:3000/api

# Supabase TEST project
NEXT_PUBLIC_SUPABASE_URL=https://your-test-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-test-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-key

# Test users are created on demand through the Supabase admin API.
# Each Playwright worker gets its own user: <prefix>+<identifier>@<domain>
TEST_USER_EMAIL_PREFIX=deliveryforge-test
TEST_USER_EMAIL_DOMAIN=deliveryforge.test
TEST_USER_PASSWORD=change-me-Str0ng!

# Safety switch: test users are only created when this is "true".
ALLOW_TEST_USER_CREATION=false

# AI. Until the fake AI provider (TC-2) exists, AI-backed routes call real Claude.
# Leave empty to keep AI-dependent tests skipped.
ANTHROPIC_API_KEY=
AI_PROVIDER=

# Browser. Set to "msedge" or "chrome" if the bundled Chromium can't be downloaded.
PW_CHANNEL=
