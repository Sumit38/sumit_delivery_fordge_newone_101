# ==============================================================================
# DeliveryForge Environment Configuration Template
# ==============================================================================
# Copy this file to:
#   - `.env.local` for local development
#   - `.env.test` for running the automated Playwright/API test suite
#
# NOTE: Never commit sensitive keys or `.env.local` / `.env.test` to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Required)
# ------------------------------------------------------------------------------
# In local development / production: Point to your Supabase project.
# In test environment (.env.test): Point to a DEDICATED Supabase test project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Anthropic Claude AI Configuration (Required for AI Features)
# ------------------------------------------------------------------------------
# Primary API key for Anthropic SDK. (CLAUDE_API_KEY is also supported as fallback)
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_API_KEY=

# Optional model tuning (defaults to Claude Opus 5.5 for graph design, Haiku for other features)
ANALYSIS_MODEL=claude-opus-5-5
ANALYSIS_EFFORT=low
ANALYSIS_FAST_MODE=true

# ------------------------------------------------------------------------------
# 3. Application & Network Settings
# ------------------------------------------------------------------------------
BASE_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# ------------------------------------------------------------------------------
# 4. Automated Test Suite Settings (For .env.test)
# ------------------------------------------------------------------------------
TEST_ENV=local

# Test users are created on demand through the Supabase admin API.
# Each Playwright worker gets its own user: <prefix>+<identifier>@<domain>
TEST_USER_EMAIL_PREFIX=deliveryforge-test
TEST_USER_EMAIL_DOMAIN=deliveryforge.test
TEST_USER_PASSWORD=change-me-Str0ng!

# Safety switch: test users are only created when this is "true".
# NEVER set to true in production!
ALLOW_TEST_USER_CREATION=false

# AI Provider mock switch (empty or "fake" when fake AI provider is used)
AI_PROVIDER=

# Browser channel: set to "msedge" or "chrome" if the bundled Chromium cannot be downloaded.
PW_CHANNEL=
